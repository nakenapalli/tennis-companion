# Copy to .env and fill in. .env is gitignored — never commit it.
# Local-dev defaults below already match docker-compose, so the app boots without a .env.

# --- Datastores ---
DATABASE_URL=jdbc:postgresql://localhost:5432/tennis
DATABASE_USER=tennis
DATABASE_PASSWORD=tennis
REDIS_URL=redis://localhost:6379

# --- Upstream live tennis feed (Phase 2) — API Tennis (api-tennis.com) ---
# IMPORTANT: values only — no inline comments, no quotes (.env parsers keep them verbatim).
# TENNIS_API_KEY is your api-tennis.com APIkey (passed as a query param, not a header).
TENNIS_API_BASE_URL=https://api.api-tennis.com/tennis/
TENNIS_API_KEY=

# --- Poll cadences / job schedules (Phase 2-3); ISO-8601 durations and Spring cron ---
# POLL_ENABLED defaults to true now (api-tennis quota is generous; 60s live ≈ 1,440 req/day).
POLL_ENABLED=true
POLL_LIVE_INTERVAL=PT1M
POLL_RANKINGS_CRON=0 0 6 * * *
POLL_TOURNAMENTS_CRON=0 30 6 * * *
DIGEST_CRON=0 0 9 * * MON
# Tier-3 LLM reconciliation batch over the review queue (Phase 6b). Default daily 07:00 UTC.
RECONCILE_TIER3_CRON=0 0 7 * * *
# RECONCILE_TIER3_ENABLED=true        # set false to keep Tier 3 manual-only (admin trigger still works)
# RECONCILE_TIER3_BATCH_SIZE=100

# --- News scraping for the weekly digest's cited context (Phase 7) ---
# Sources are code (one SiteScraper per site, e.g. tennis.com). Articles are used transiently as LLM
# context and never persisted; if none can be scraped the digest run is skipped. Article-sourced facts
# are cited inline and anti-plagiarism-checked.
NEWS_ENABLED=true
# NEWS_MAX_ARTICLES=4
# NEWS_MAX_AGE_DAYS=8
# NEWS_PER_ARTICLE_CHAR_CAP=4000

# --- LLM (Anthropic), insight generation only (Phase 6) ---
# Reuses ANTHROPIC_API_KEY if LLM_API_KEY is unset. Models default to Sonnet (digest) / Haiku (Tier 3).
ANTHROPIC_API_KEY=
# LLM_API_KEY=          # optional override; falls back to ANTHROPIC_API_KEY
# LLM_MODEL=claude-sonnet-4-6
# LLM_TIER3_MODEL=claude-haiku-4-5
# LLM_ENABLED=true

# --- Auth (Phase 4) ---
# JWT_SECRET must be >= 32 bytes for HS256 (blank = the dev default in application.yml).
JWT_SECRET=
# Optional: auto-create an admin user (required for the gated /api/admin/** endpoints, incl. poll triggers).
ADMIN_EMAIL=
ADMIN_PASSWORD=
