{
  "info": {
    "_postman_id": "b1f2c3d4-0001-4a2b-8c3d-tenniscompanion",
    "name": "Tennis Companion",
    "description": "Phases 0-7. Set the `baseUrl` collection variable to your running port. Player ids: ATP = raw Sackmann id; WTA = raw id + 1,000,000,000.\n\nThe scores/rankings/tournaments READ endpoints serve from cache (no upstream calls). The /api/admin/poll/* endpoints hit the upstream feed (API Tennis, ~8,000 req/day on Starter) — scheduled polling is on by default, so you usually don't need them. The weekly AI digest (Insights folder) calls Anthropic, blends in cited full-text news scraped from chosen sites (preview via 'Preview news feed' — no LLM call), fact-checks the result, and auto-publishes only if the fact-check passes (else it stays a DRAFT).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "token", "value": "" },
    { "key": "insightId", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [ { "key": "token", "value": "{{token}}", "type": "string" } ]
  },
  "item": [
    {
      "name": "Auth (Phase 4)",
      "description": "Register or log in — the token is saved to {{token}} and auto-attached to every request (collection-level bearer auth). To use /api/admin/**, log in as an admin (set ADMIN_EMAIL/ADMIN_PASSWORD in .env first).",
      "item": [
        {
          "name": "Register",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('200', () => pm.response.to.have.status(200));", "if (pm.response.code === 200) pm.collectionVariables.set('token', pm.response.json().token);" ] } } ],
          "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" } ], "body": { "mode": "raw", "raw": "{\n  \"email\": \"fan@example.com\",\n  \"password\": \"password123\"\n}" }, "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] } }
        },
        {
          "name": "Login",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('200', () => pm.response.to.have.status(200));", "if (pm.response.code === 200) pm.collectionVariables.set('token', pm.response.json().token);" ] } } ],
          "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" } ], "body": { "mode": "raw", "raw": "{\n  \"email\": \"fan@example.com\",\n  \"password\": \"password123\"\n}" }, "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] } }
        },
        {
          "name": "Login as admin",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('200', () => pm.response.to.have.status(200));", "if (pm.response.code === 200) pm.collectionVariables.set('token', pm.response.json().token);" ] } } ],
          "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" } ], "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@local\",\n  \"password\": \"adminpass123\"\n}" }, "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] } }
        }
      ]
    },
