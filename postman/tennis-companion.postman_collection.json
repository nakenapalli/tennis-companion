          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/tournaments/{{tournamentId}}/matches", "host": ["{{baseUrl}}"], "path": ["api", "tournaments", "{{tournamentId}}", "matches"] } }
