          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/matches/{{matchExternalId}}/stats", "host": ["{{baseUrl}}"], "path": ["api", "matches", "{{matchExternalId}}", "stats"] } }
        },
        {
          "name": "Head-to-head tab",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('200 or 404', () => pm.expect([200,404]).to.include(pm.response.code));" ] } } ],
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/matches/{{matchExternalId}}/h2h", "host": ["{{baseUrl}}"], "path": ["api", "matches", "{{matchExternalId}}", "h2h"] } }
        },
        {
          "name": "Players tab (bios + career splits)",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('200 or 404', () => pm.expect([200,404]).to.include(pm.response.code));" ] } } ],
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/matches/{{matchExternalId}}/players", "host": ["{{baseUrl}}"], "path": ["api", "matches", "{{matchExternalId}}", "players"] } }
        }
      ]
    },
    {
      "name": "Chat — per match (cache-only, SSE)",
      "description": "Redis-backed chat, 1-day TTL, never persisted. Reads are public; creating a thread / posting a message needs a login (run Auth first) and a non-finished match (423 once the match is over). The two *.../stream endpoints are Server-Sent Events (text/event-stream) — meant for EventSource; in Postman they stay open and stream, so cancel them manually.",
      "item": [
        {
          "name": "List threads (public)",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('200', () => pm.response.to.have.status(200));", "const b = pm.response.json();", "const t = (b.active && b.active[0]) || (b.latest && b.latest[0]);", "if (t && t.id) pm.collectionVariables.set('threadId', t.id);" ] } } ],
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/matches/{{matchExternalId}}/threads", "host": ["{{baseUrl}}"], "path": ["api", "matches", "{{matchExternalId}}", "threads"] } }
        },
        {
          "name": "Create thread (auth; 423 if match finished)",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('200 or 423 (locked) or 401', () => pm.expect([200,423,401]).to.include(pm.response.code));", "if (pm.response.code === 200 && pm.response.json().id) pm.collectionVariables.set('threadId', pm.response.json().id);" ] } } ],
          "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" } ], "body": { "mode": "raw", "raw": "{\n  \"title\": \"What a rally\"\n}" }, "url": { "raw": "{{baseUrl}}/api/matches/{{matchExternalId}}/threads", "host": ["{{baseUrl}}"], "path": ["api", "matches", "{{matchExternalId}}", "threads"] } }
        },
        {
          "name": "Thread detail ({{threadId}})",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('200 or 404', () => pm.expect([200,404]).to.include(pm.response.code));" ] } } ],
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/matches/{{matchExternalId}}/threads/{{threadId}}", "host": ["{{baseUrl}}"], "path": ["api", "matches", "{{matchExternalId}}", "threads", "{{threadId}}"] } }
        },
        {
          "name": "Post message (auth; 423 if finished)",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('200 or 423 or 401', () => pm.expect([200,423,401]).to.include(pm.response.code));" ] } } ],
          "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" } ], "body": { "mode": "raw", "raw": "{\n  \"text\": \"Best point of the match\"\n}" }, "url": { "raw": "{{baseUrl}}/api/matches/{{matchExternalId}}/threads/{{threadId}}/messages", "host": ["{{baseUrl}}"], "path": ["api", "matches", "{{matchExternalId}}", "threads", "{{threadId}}", "messages"] } }
        },
        {
          "name": "SSE — thread list stream (cancel manually)",
          "request": { "method": "GET", "header": [ { "key": "Accept", "value": "text/event-stream" } ], "url": { "raw": "{{baseUrl}}/api/matches/{{matchExternalId}}/threads/stream", "host": ["{{baseUrl}}"], "path": ["api", "matches", "{{matchExternalId}}", "threads", "stream"] } }
        },
        {
          "name": "SSE — messages stream ({{threadId}}, cancel manually)",
          "request": { "method": "GET", "header": [ { "key": "Accept", "value": "text/event-stream" } ], "url": { "raw": "{{baseUrl}}/api/matches/{{matchExternalId}}/threads/{{threadId}}/stream", "host": ["{{baseUrl}}"], "path": ["api", "matches", "{{matchExternalId}}", "threads", "{{threadId}}", "stream"] } }
        }
      ]
    },
