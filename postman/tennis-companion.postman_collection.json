{
  "info": {
    "_postman_id": "b1f2c3d4-0001-4a2b-8c3d-tenniscompanion",
    "name": "Tennis Companion",
    "description": "Phases 0-7. Set the `baseUrl` collection variable to your running port.\n\nPlayer ids are now **UUIDs** (`players.id`) — DB-generated, so they differ per load and can't be hard-coded. Run the **Rankings** and **Live scores** requests first: their test scripts auto-capture a `{{playerId}}` / `{{opponentId}}` / `{{matchExternalId}}` / `{{tournamentId}}` into collection variables that the Players / Match detail / Chat / Tournament-detail requests then use. (The legacy namespaced Sackmann integer survives as `players.sackmann_id`, ATP = raw, WTA = raw + 1e9, but the API addresses players by UUID.)\n\nThe scores/rankings/tournaments/match-detail READ endpoints serve from cache (no upstream call on read). The `/api/admin/poll/*` endpoints hit the upstream feed (API Tennis, ~8k req/day on Starter) — scheduled polling is on by default, so you usually don't need them. Per-match **chat** reads are public SSE/REST; posting needs a login. The weekly AI **digest** calls Anthropic, blends in cited scraped news, fact-checks, and auto-publishes only if clean (else DRAFT).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "token", "value": "" },
    { "key": "playerId", "value": "" },
    { "key": "opponentId", "value": "" },
    { "key": "matchExternalId", "value": "" },
    { "key": "tournamentId", "value": "" },
    { "key": "threadId", "value": "" },
    { "key": "unmappedExternalId", "value": "" },
    { "key": "insightId", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [ { "key": "token", "value": "{{token}}", "type": "string" } ]
  },
  "item": [
    {
      "name": "Auth (Phase 4)",
      "description": "Register or log in — the token is saved to {{token}} and auto-attached to every request (collection-level bearer auth). Registration now requires a `username` (3-20 chars, letters/numbers/underscore) — it's the public handle shown on chat messages. To use /api/admin/**, log in as an admin (set ADMIN_EMAIL/ADMIN_PASSWORD in .env first).",
      "item": [
        {
          "name": "Register",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('200 or 409 (already registered)', () => pm.expect([200,409]).to.include(pm.response.code));", "if (pm.response.code === 200) pm.collectionVariables.set('token', pm.response.json().token);" ] } } ],
          "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" } ], "body": { "mode": "raw", "raw": "{\n  \"email\": \"fan@example.com\",\n  \"username\": \"fan\",\n  \"password\": \"password123\"\n}" }, "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] } }
        },
        {
          "name": "Login",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('200', () => pm.response.to.have.status(200));", "if (pm.response.code === 200) pm.collectionVariables.set('token', pm.response.json().token);" ] } } ],
          "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" } ], "body": { "mode": "raw", "raw": "{\n  \"email\": \"fan@example.com\",\n  \"password\": \"password123\"\n}" }, "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] } }
        },
        {
          "name": "Login as admin",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('200', () => pm.response.to.have.status(200));", "if (pm.response.code === 200) pm.collectionVariables.set('token', pm.response.json().token);" ] } } ],
          "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" } ], "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@local\",\n  \"password\": \"adminpass123\"\n}" }, "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] } }
        }
      ]
    },
    {
      "name": "Health",
      "item": [
        {
          "name": "API health",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('200', () => pm.response.to.have.status(200));", "pm.test('status UP', () => pm.expect(pm.response.json().status).to.eql('UP'));" ] } } ],
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/health", "host": ["{{baseUrl}}"], "path": ["api", "health"] } }
        },
        {
          "name": "Actuator health (db + redis)",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('200', () => pm.response.to.have.status(200));" ] } } ],
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/actuator/health", "host": ["{{baseUrl}}"], "path": ["actuator", "health"] } }
        }
      ]
    },
    {
      "name": "Live scores (Phase 2)",
      "description": "Served from cache (no upstream call). 'Live matches' / 'Recently completed' capture the first match's externalId into {{matchExternalId}} for the Match detail + Chat folders.",
      "item": [
        {
          "name": "Live matches (cached)",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('200', () => pm.response.to.have.status(200));", "pm.test('is array', () => pm.expect(pm.response.json()).to.be.an('array'));", "const a = pm.response.json();", "if (a[0] && a[0].externalId) pm.collectionVariables.set('matchExternalId', a[0].externalId);", "// empty until a live poll has run (scheduled on by default, or POST /api/admin/poll/live)" ] } } ],
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/scores/live", "host": ["{{baseUrl}}"], "path": ["api", "scores", "live"] } }
        },
        {
          "name": "Recently completed matches",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('200', () => pm.response.to.have.status(200));", "pm.test('is array', () => pm.expect(pm.response.json()).to.be.an('array'));", "const a = pm.response.json();", "// fall back to a finished match for the detail tabs if nothing is live", "if (!pm.collectionVariables.get('matchExternalId') && a[0] && a[0].externalId) pm.collectionVariables.set('matchExternalId', a[0].externalId);" ] } } ],
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/scores/recent", "host": ["{{baseUrl}}"], "path": ["api", "scores", "recent"] } }
        }
      ]
    },
    {
      "name": "Rankings (Phase 2)",
      "description": "Served from cache. 'ATP rankings' captures the first two reconciled rows' UUIDs into {{playerId}} and {{opponentId}} for the Players / Me folders.",
      "item": [
        {
          "name": "ATP rankings (limit=20)",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('200', () => pm.response.to.have.status(200));", "pm.test('is array', () => pm.expect(pm.response.json()).to.be.an('array'));", "const withId = pm.response.json().filter(r => r.playerId); // reconciled rows carry the canonical UUID", "if (withId[0]) pm.collectionVariables.set('playerId', withId[0].playerId);", "if (withId[1]) pm.collectionVariables.set('opponentId', withId[1].playerId);" ] } } ],
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/rankings?tour=ATP&limit=20", "host": ["{{baseUrl}}"], "path": ["api", "rankings"], "query": [ { "key": "tour", "value": "ATP" }, { "key": "limit", "value": "20" } ] } }
        },
        {
          "name": "WTA rankings (limit=20)",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('200', () => pm.response.to.have.status(200));" ] } } ],
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/rankings?tour=WTA&limit=20", "host": ["{{baseUrl}}"], "path": ["api", "rankings"], "query": [ { "key": "tour", "value": "WTA" }, { "key": "limit", "value": "20" } ] } }
        }
      ]
    },
    {
      "name": "Players — profile, matches & h2h",
      "description": "Uses {{playerId}} / {{opponentId}} captured by the Rankings folder (run that first). Player ids are UUIDs.",
      "item": [
        {
          "name": "Player profile ({{playerId}})",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('200', () => pm.response.to.have.status(200));", "pm.test('has lastName', () => pm.expect(pm.response.json()).to.have.property('lastName'));" ] } } ],
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/players/{{playerId}}", "host": ["{{baseUrl}}"], "path": ["api", "players", "{{playerId}}"] } }
        },
        {
          "name": "Recent matches (limit=5)",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('200', () => pm.response.to.have.status(200));", "pm.test('<= 5 rows', () => pm.expect(pm.response.json().length).to.be.at.most(5));" ] } } ],
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/players/{{playerId}}/matches?limit=5", "host": ["{{baseUrl}}"], "path": ["api", "players", "{{playerId}}", "matches"], "query": [ { "key": "limit", "value": "5" } ] } }
        },
        {
          "name": "Head-to-head ({{playerId}} vs {{opponentId}})",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('200', () => pm.response.to.have.status(200));", "const b = pm.response.json();", "pm.test('totals add up', () => pm.expect(b.playerWins + b.opponentWins).to.eql(b.matches.length));" ] } } ],
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/players/{{playerId}}/h2h?opponentId={{opponentId}}", "host": ["{{baseUrl}}"], "path": ["api", "players", "{{playerId}}", "h2h"], "query": [ { "key": "opponentId", "value": "{{opponentId}}" } ] } }
        }
      ]
    },
    {
      "name": "Match detail — momentum/stats/h2h/players (Phase 7)",
      "description": "The match-view tabs. All keyed by the api-tennis external_id ({{matchExternalId}}, captured by the Live scores folder). One cached upstream fetch backs them; the sub-tabs 404 when the feed carries no point/stat data (common on lower circuits), so [200,404] is the expected set.",
      "item": [
        {
          "name": "Match detail snapshot",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('200 or 404', () => pm.expect([200,404]).to.include(pm.response.code));" ] } } ],
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/matches/{{matchExternalId}}", "host": ["{{baseUrl}}"], "path": ["api", "matches", "{{matchExternalId}}"] } }
        },
        {
          "name": "Momentum (bespoke line)",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('200 or 404 (no point-by-point)', () => pm.expect([200,404]).to.include(pm.response.code));", "if (pm.response.code === 200) pm.test('has a series', () => pm.expect(pm.response.json()).to.have.property('series'));" ] } } ],
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/matches/{{matchExternalId}}/momentum", "host": ["{{baseUrl}}"], "path": ["api", "matches", "{{matchExternalId}}", "momentum"] } }
