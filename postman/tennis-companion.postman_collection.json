    {
      "name": "Insights — weekly AI digest (Phase 6a)",
      "description": "Admin generates a DRAFT (calls Anthropic, grounded in DB facts), reviews it, then publishes. The public endpoints serve only PUBLISHED insights. Generation needs current data — run the rankings/recent/tournaments polls first if the DB is empty. 'Generate' saves the new id to {{insightId}} for the publish/by-id requests.",
      "item": [
        {
          "name": "Preview news feed (admin, no LLM call)",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('200', () => pm.response.to.have.status(200));", "pm.test('reports a count', () => pm.expect(pm.response.json()).to.have.property('count'));", "// debug the RSS half before generating: count=0 with feeds listed = a feed is unreachable/non-XML" ] } } ],
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/admin/news/preview?days=8&limit=10", "host": ["{{baseUrl}}"], "path": ["api", "admin", "news", "preview"], "query": [ { "key": "days", "value": "8" }, { "key": "limit", "value": "10" } ] } }
        },
        {
          "name": "Generate digest (admin, ⚠ calls Anthropic)",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('200', () => pm.response.to.have.status(200));", "const id = pm.response.json().draftId;", "if (id) { pm.collectionVariables.set('insightId', id); }", "pm.test('returned a draftId (null = skipped: no data to ground on)', () => pm.expect(pm.response.json()).to.have.property('draftId'));" ] } } ],
          "request": { "method": "POST", "header": [], "url": { "raw": "{{baseUrl}}/api/admin/insights/generate", "host": ["{{baseUrl}}"], "path": ["api", "admin", "insights", "generate"] } }
        },
        {
          "name": "List drafts (admin)",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('200', () => pm.response.to.have.status(200));", "pm.test('is array', () => pm.expect(pm.response.json()).to.be.an('array'));" ] } } ],
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/admin/insights?status=DRAFT", "host": ["{{baseUrl}}"], "path": ["api", "admin", "insights"], "query": [ { "key": "status", "value": "DRAFT" } ] } }
        },
        {
          "name": "Publish insight (admin, uses {{insightId}})",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('200', () => pm.response.to.have.status(200));", "pm.test('published', () => pm.expect(pm.response.json().published).to.eql(true));" ] } } ],
          "request": { "method": "POST", "header": [], "url": { "raw": "{{baseUrl}}/api/admin/insights/{{insightId}}/publish", "host": ["{{baseUrl}}"], "path": ["api", "admin", "insights", "{{insightId}}", "publish"] } }
        },
        {
          "name": "Latest published digest (public)",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('200 or 204', () => pm.expect([200,204]).to.include(pm.response.code));", "// 204 = nothing published yet" ] } } ],
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/insights/latest?type=weekly_digest", "host": ["{{baseUrl}}"], "path": ["api", "insights", "latest"], "query": [ { "key": "type", "value": "weekly_digest" } ] } }
        },
        {
          "name": "Insight by id (public, uses {{insightId}})",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('200 or 404', () => pm.expect([200,404]).to.include(pm.response.code));", "// 404 until that id is PUBLISHED" ] } } ],
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/insights/{{insightId}}", "host": ["{{baseUrl}}"], "path": ["api", "insights", "{{insightId}}"] } }
