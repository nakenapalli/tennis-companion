          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/tournaments/{{tournamentId}}/threads", "host": ["{{baseUrl}}"], "path": ["api", "tournaments", "{{tournamentId}}", "threads"] } }
